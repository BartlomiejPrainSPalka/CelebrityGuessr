<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:CelebrityGuessr.Models"
             x:Class="CelebrityGuessr.Modes.PictureMode"
             BackgroundColor="#070b1a">

    <Grid RowDefinitions="Auto, Auto, *, Auto" Padding="5">
        <Border Grid.Row="0"
                Stroke="White"
                StrokeThickness="3"
                BackgroundColor="#2b2b3b"
                HeightRequest="200"
                WidthRequest="200"
                Margin="0, 10, 0, 15"
                StrokeShape="RoundRectangle 10"
                HorizontalOptions="Center">
            <Grid>
                <Image x:Name="ClueImage"
                       Aspect="Fill"
                       HorizontalOptions="Fill"
                       VerticalOptions="Fill"
                       BackgroundColor="Black"/>
            </Grid>
        </Border>

        <VerticalStackLayout Grid.Row="1" Spacing="5" VerticalOptions="End">
            <Border StrokeShape="RoundRectangle 10"
                    StrokeThickness="2"
                    Stroke="White">
                <Entry x:Name="SearchEntry" 
                       Placeholder="Wpisz nazwisko..." 
                       TextColor="White"
                       PlaceholderColor="Gray"
                       BackgroundColor="#252b3d"
                       TextChanged="OnSearchTextChanged"/>
            </Border>
        </VerticalStackLayout>
        <VerticalStackLayout ZIndex="10" Grid.Row="2">
            <Border StrokeShape="RoundRectangle 10"
                    Stroke="Transparent"
                    StrokeThickness="2">
                <CollectionView x:Name="SuggestionsList"
                            HeightRequest="0"
                            IsVisible="False"
                            BackgroundColor="#252b3d"
                            SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Celebrity">
                            <Border Stroke="Transparent" BackgroundColor="Transparent" Padding="10">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnSuggestionTapped" CommandParameter="{Binding .}"/>
                                </Border.GestureRecognizers>
                                <Label Text="{Binding Name}" TextColor="White" />
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Border>
        </VerticalStackLayout>

        <CollectionView Grid.Row="2" x:Name="GuessesList" Margin="0,10">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:GuessResult">
                    <Grid ColumnDefinitions="0.75*" Padding="0,4" HeightRequest="50">
                        <Border Grid.Column="0" BackgroundColor="{Binding NameColor}" StrokeShape="RoundRectangle 10" Margin="1" Padding="2">
                            <Label Text="{Binding GuessData.Name}" TextColor="White" FontSize="15" HorizontalOptions="Center" VerticalOptions="Center" LineBreakMode="WordWrap" HorizontalTextAlignment="Center"/>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:CelebrityGuessr.Models"
             x:Class="CelebrityGuessr.Modes.PictureMode"
             Title="Tryb Zdjęcia">

    <ContentPage.Resources>
        <Color x:Key="CardBg">#161B33</Color>
        <Color x:Key="InputBg">#1E2440</Color>
        <Color x:Key="CardStroke">#2A315A</Color>
        <Color x:Key="AccentColor">#FFC107</Color>
    </ContentPage.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#05060F" Offset="0.0" />
                <GradientStop Color="#0F1230" Offset="0.55" />
                <GradientStop Color="#1A1145" Offset="1.0" />
            </LinearGradientBrush>
        </Grid.Background>

        <Grid RowDefinitions="Auto, Auto, *" Padding="12,10">

            <!--  Zdjęcie-zagadka  -->
            <Border Grid.Row="0"
                    Stroke="{StaticResource AccentColor}"
                    StrokeThickness="2.5"
                    BackgroundColor="{StaticResource CardBg}"
                    HeightRequest="210"
                    WidthRequest="210"
                    Margin="0,4,0,16"
                    StrokeShape="RoundRectangle 18"
                    HorizontalOptions="Center">
                <Border.Shadow>
                    <Shadow Brush="{StaticResource AccentColor}" Offset="0,0" Radius="24" Opacity="0.3" />
                </Border.Shadow>
                <Grid>
                    <Image x:Name="ClueImage"
                           Aspect="Fill"
                           HorizontalOptions="Fill"
                           VerticalOptions="Fill"
                           BackgroundColor="Black" />
                </Grid>
            </Border>

            <!--  Pole wyszukiwania  -->
            <Border Grid.Row="1"
                    StrokeShape="RoundRectangle 12"
                    Stroke="{StaticResource CardStroke}"
                    StrokeThickness="1.5"
                    BackgroundColor="{StaticResource InputBg}"
                    Margin="0,0,0,4">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,4" Radius="10" Opacity="0.25" />
                </Border.Shadow>

                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup Name="FocusStates">
                        <VisualState Name="Focused">
                            <VisualState.Setters>
                                <Setter Property="Stroke" Value="{StaticResource AccentColor}" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState Name="Unfocused">
                            <VisualState.Setters>
                                <Setter Property="Stroke" Value="{StaticResource CardStroke}" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>

                <Entry x:Name="SearchEntry"
                       Placeholder="Wpisz nazwisko..."
                       TextColor="White"
                       PlaceholderColor="#7F86AD"
                       BackgroundColor="Transparent"
                       Margin="8,0"
                       FontSize="16"
                       TextChanged="OnSearchTextChanged" />
            </Border>

            <!--  Podpowiedzi - nakładka nad listą wyników  -->
            <VerticalStackLayout ZIndex="10" Grid.Row="2" VerticalOptions="Start">
                <Border StrokeShape="RoundRectangle 12"
                        Stroke="{StaticResource CardStroke}"
                        StrokeThickness="1"
                        BackgroundColor="{StaticResource InputBg}"
                        Padding="0">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,8" Radius="16" Opacity="0.4" />
                    </Border.Shadow>

                    <CollectionView x:Name="SuggestionsList"
                                HeightRequest="0"
                                IsVisible="False"
                                BackgroundColor="Transparent"
                                SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Celebrity">
                                <Border Stroke="Transparent" BackgroundColor="Transparent" Padding="14,12">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnSuggestionTapped" CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Label Text="{Binding Name}" TextColor="White" FontSize="15" />
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Border>
            </VerticalStackLayout>

            <!--  Lista prób - karty, najnowsza zawsze widoczna dzięki auto-scrollowi  -->
            <CollectionView Grid.Row="2" x:Name="GuessesList" Margin="0,8,0,0">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:GuessResult">
                        <Border StrokeShape="RoundRectangle 12"
                                Stroke="Transparent"
                                BackgroundColor="{Binding NameColor}"
                                Padding="14,12,14,16">
                            <Border.Shadow>
                                <Shadow Brush="Black" Offset="0,3" Radius="8" Opacity="0.25" />
                            </Border.Shadow>
                            <Label Text="{Binding GuessData.Name}"
                                   TextColor="White"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   HorizontalTextAlignment="Center"
                                   LineBreakMode="TailTruncation" />
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <!--  Overlay z gratulacjami po zgadnięciu poprawnej osoby  -->
        <Grid x:Name="WinOverlay"
              IsVisible="False"
              Opacity="0"
              BackgroundColor="#CC000000">

            <Border StrokeShape="RoundRectangle 24"
                    Stroke="{StaticResource AccentColor}"
                    StrokeThickness="1.5"
                    BackgroundColor="{StaticResource CardBg}"
                    Padding="24,24,24,32"
                    Margin="28"
                    VerticalOptions="Center"
                    MaximumWidthRequest="380"
                    x:Name="WinCard">
                <Border.Shadow>
                    <Shadow Brush="{StaticResource AccentColor}" Offset="0,0" Radius="30" Opacity="0.35" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="12">

                    <Label Text="🎉" FontSize="42" HorizontalTextAlignment="Center" />

                    <Label Text="Brawo, zgadłeś!"
                           TextColor="{StaticResource AccentColor}"
                           FontAttributes="Bold"
                           FontSize="22"
                           HorizontalTextAlignment="Center" />

                    <!--  Pełne, nieprzybliżone zdjęcie odgadniętej osoby  -->
                    <Border StrokeShape="RoundRectangle 14"
                            Stroke="{StaticResource CardStroke}"
                            StrokeThickness="1"
                            HeightRequest="160"
                            WidthRequest="160"
                            HorizontalOptions="Center"
                            Padding="0">
                        <Image x:Name="WinImage" Aspect="AspectFill" />
                    </Border>

                    <Label x:Name="WinNameLabel"
                           TextColor="White"
                           FontAttributes="Bold"
                           FontSize="19"
                           HorizontalTextAlignment="Center" />

                    <Label x:Name="WinAttemptsLabel"
                           TextColor="#D8DAE8"
                           FontSize="14"
                           HorizontalTextAlignment="Center"
                           Margin="0,2,0,10" />

                    <Border StrokeShape="RoundRectangle 12"
                            Stroke="Transparent"
                            BackgroundColor="{StaticResource AccentColor}"
                            Padding="18,12,18,20">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnPlayAgainTapped" />
                        </Border.GestureRecognizers>
                        <Label Text="Zagraj jeszcze raz"
                               TextColor="#161B33"
                               FontAttributes="Bold"
                               FontSize="15"
                               HorizontalTextAlignment="Center" />
                    </Border>

                    <Border StrokeShape="RoundRectangle 12"
                            Stroke="{StaticResource CardStroke}"
                            StrokeThickness="1.5"
                            BackgroundColor="Transparent"
                            Padding="18,12,18,20">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnBackToMenuTapped" />
                        </Border.GestureRecognizers>
                        <Label Text="Wróć do menu"
                               TextColor="#D8DAE8"
                               FontAttributes="Bold"
                               FontSize="15"
                               HorizontalTextAlignment="Center" />
                    </Border>

                </VerticalStackLayout>
            </Border>
        </Grid>

        <!--  Overlay potwierdzenia wyjścia - zastępuje systemowy DisplayAlert  -->
        <Grid x:Name="ExitConfirmOverlay"
              IsVisible="False"
              Opacity="0"
              BackgroundColor="#CC000000">

            <Border StrokeShape="RoundRectangle 20"
                    Stroke="{StaticResource CardStroke}"
                    StrokeThickness="1"
                    BackgroundColor="{StaticResource CardBg}"
                    Padding="22,22,22,30"
                    Margin="15"
                    VerticalOptions="Center"
                    MaximumWidthRequest="380">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,10" Radius="24" Opacity="0.5" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="14">

                    <Label Text="Wyjście"
                           TextColor="{StaticResource AccentColor}"
                           FontAttributes="Bold"
                           FontSize="18"
                           HorizontalTextAlignment="Center" />

                    <Label Text="Czy na pewno chcesz wyjść? Stracisz progres oraz wylosowana zostanie nowa osoba."
                           TextColor="#D8DAE8"
                           FontSize="14"
                           HorizontalTextAlignment="Center" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">

                        <Border Grid.Column="0"
                                StrokeShape="RoundRectangle 10"
                                Stroke="{StaticResource CardStroke}"
                                StrokeThickness="1.5"
                                BackgroundColor="Transparent"
                                Padding="18,18,18,18">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnExitCancelTapped" />
                            </Border.GestureRecognizers>
                            <Label Text="Anuluj"
                                   TextColor="#D8DAE8"
                                   FontAttributes="Bold"
                                   FontSize="15"
                                   HorizontalTextAlignment="Center" />
                        </Border>

                        <Border Grid.Column="1"
                                StrokeShape="RoundRectangle 10"
                                Stroke="Transparent"
                                BackgroundColor="#E5484D"
                                Padding="18,18,18,18">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnExitConfirmTapped" />
                            </Border.GestureRecognizers>
                            <Label Text="Tak, wyjdź"
                                   TextColor="White"
                                   FontAttributes="Bold"
                                   FontSize="15"
                                   HorizontalTextAlignment="Center" />
                        </Border>

                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
